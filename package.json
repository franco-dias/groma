{
  "name": "gromajs",
  "version": "0.6.3",
  "description": "Groma: inspect any web page like a design file. A Figma-style inspector for web pages, apps and design handoffs: box model, specs, design tokens, components and distances, with one script.",
  "keywords": [
    "groma",
    "inspector",
    "design-handoff",
    "web-inspector",
    "design-tokens",
    "devtools",
    "figma",
    "dev-mode"
  ],
  "author": "Gabriel Franco (https://github.com/franco-dias)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/groma.js",
  "unpkg": "./dist/groma.js",
  "jsdelivr": "./dist/groma.js",
  "bin": {
    "gromajs": "scripts/inspect.mjs"
  },
  "files": [
    "dist",
    "scripts/inspect.mjs",
    "scripts/inject.mjs"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "serve": "vite",
    "inspect": "vite build --logLevel warn && node scripts/inspect.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "release:check": "npm publish --dry-run"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franco-dias/groma.git"
  },
  "homepage": "https://gromajs.dev",
  "bugs": {
    "url": "https://github.com/franco-dias/groma/issues"
  }
}
