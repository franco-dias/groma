{
  "name": "live-inspector",
  "version": "0.1.0",
  "private": true,
  "description": "Figma-style inspector for design handoff pages: box model, specs, design tokens and distances on any HTML page.",
  "keywords": ["inspector", "design-handoff", "design-tokens", "devtools"],
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/live-inspector.js",
  "unpkg": "./dist/live-inspector.js",
  "jsdelivr": "./dist/live-inspector.js",
  "files": ["dist"],
  "scripts": {
    "serve": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
