{
  "name": "groma",
  "version": "0.3.0",
  "description": "Groma: survey any design before you build it. A Figma-style inspector for design handoff pages: box model, specs, design tokens, components and distances on any HTML page.",
  "keywords": [
    "inspector",
    "design-handoff",
    "design-tokens",
    "devtools",
    "figma",
    "dev-mode",
    "ai-design"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/groma.js",
  "unpkg": "./dist/groma.js",
  "jsdelivr": "./dist/groma.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "serve": "vite",
    "inspect": "vite build --logLevel warn && node scripts/inspect.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "release:check": "npm publish --dry-run"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franco-dias/groma.git"
  },
  "homepage": "https://github.com/franco-dias/groma#readme",
  "bugs": {
    "url": "https://github.com/franco-dias/groma/issues"
  }
}
